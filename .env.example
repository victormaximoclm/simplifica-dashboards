# ============================================
# Simpla Insights — Variáveis de Ambiente
# ============================================
# Copie para .env e ajuste. Nunca commite .env com segredos reais.

# ── App (geral) ─────────────────────────────
# (Opcional) BasePath da aplicação (Next.js). Vazio = raiz.
# Use apenas se você for servir a aplicação em subpath (ex.: /app).
BASEPATH=

# ── App (URLs) ──────────────────────────────

# URL pública (links em e-mails e redirects). Sem barra no final.
# Local: http://localhost:3000
# Docker (host): http://localhost:3000
# EasyPanel: https://seu-dominio.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API consumida pelo browser (rotas /api/*). Deve coincidir com o host público + /api
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# (Opcional) BasePath do NextAuth (use apenas se você alterou o padrão `/api/auth`)
# NEXTAUTH_BASEPATH=/api/auth

# (Opcional / template) URL de documentação do template. Pode deixar vazio.
# NEXT_PUBLIC_DOCS_URL=

# ── Banco de dados (PostgreSQL) ─────────────
# Local (app fora do Docker, Postgres na porta 5433 do compose):
# DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5433/NOME_DB?schema=public
#
# App dentro do Docker Compose (host do serviço é o nome do serviço):
# DATABASE_URL=postgresql://USUARIO:SENHA@postgres:5432/NOME_DB?schema=public
#
# Não use ${VAR} dentro do .env para Prisma — o arquivo é lido literalmente.
DATABASE_URL=postgresql://simplifica:simplifica123@localhost:5433/simplifica?schema=public

# As variáveis abaixo são usadas pelo Docker Compose para subir o Postgres.
# Se você roda tudo fora do Docker, pode ignorar e usar apenas DATABASE_URL.
DB_NAME=simplifica
DB_USER=simplifica
DB_PASSWORD=simplifica123

# Porta do Postgres exposta no host (compose). Default: 5433
DB_PORT_EXTERNAL=5433

# ── NextAuth ────────────────────────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=trocar_por_segredo_longo

# URL base do site para callbacks (sem /api/auth no final em v4)
# Local: http://localhost:3000
# Produção: https://seu-dominio.com
NEXTAUTH_URL=http://localhost:3000

# Opcional: OAuth Google (só habilita o provider se ambos estiverem definidos)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── API interna (servidor → /api/login no NextAuth authorize) ──
# Deve ser a URL que o processo Node usa para chamar a própria API.
# Local: http://localhost:3000/api
# Docker (mesmo container): http://localhost:3000/api
# Se o app só escutar em 127.0.0.1, pode usar http://127.0.0.1:3000/api
API_URL=http://localhost:3000/api

# ── Redis (rate limit distribuído) ──────────
# Local (app fora do Docker): redis://localhost:6379
# Docker Compose (app dentro do container): redis://redis:6379
# Se não definido em dev, o rate limit cai para memória (não recomendado para produção).
REDIS_URL=redis://redis:6379

# ── Embed / segurança ────────────────────────
# Segredo para assinar tokens internos do embed.
# Se não definido, usa NEXTAUTH_SECRET.
# EMBED_PROXY_SECRET=

# ── SMTP ────────────────────────────────────
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Simplifica" <noreply@exemplo.com>

# ── Logs ────────────────────────────────────
# Níveis: fatal | error | warn | info | debug | trace
# LOG_LEVEL=debug

# ── Docker / produção ───────────────────────
# Roda seed ao subir o container (apenas fluxo não-destrutivo em seed.js --production)
SEED_ON_START=false

# HSTS: configure no proxy (EasyPanel / Nginx), não no app — evita cache incorreto em HTTP.
