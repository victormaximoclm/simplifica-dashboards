# ============================================
# Simplifica Dashboards — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores.
# Em produção, todas essas variáveis devem estar configuradas.

# ── App ──────────────────────────────────────
# Base path da aplicação (deixe vazio para raiz)
BASEPATH=

# URL pública da aplicação (usada em emails e links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Banco de Dados (PostgreSQL) ──────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=simplifica
DB_USER=simplifica
DB_PASSWORD=TROCAR_SENHA_FORTE_AQUI

# URL construída automaticamente (não edite manualmente)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# ── Autenticação (NextAuth.js) ───────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=TROCAR_POR_TOKEN_SEGURO
NEXTAUTH_URL=http://localhost:3000/api/auth
NEXTAUTH_BASEPATH=/api/auth

# ── Google OAuth 2.0 (opcional) ──────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SMTP (Email) ─────────────────────────────
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-usuario@exemplo.com
SMTP_PASS=sua-senha-smtp
SMTP_FROM="Simplifica Dashboards" <noreply@exemplo.com>

# ── API (interno) ────────────────────────────
API_URL=http://localhost:3000/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ── Seed automático ──────────────────────────
# true = cria super admin automaticamente na primeira execução
SEED_ON_START=true
